#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* =========================================================
         * СЛОЙ 0: DEFAULT (основной)
         * ========================================================= */
        default_layer {
            bindings = <
// |--------+--------+--------+--------+--------+--------|   |--------+--------+--------+--------+--------+--------|
     &kp TAB  &kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I    &kp O    &kp P    &kp BSPC
// |--------+--------+--------+--------+--------+--------|   |--------+--------+--------+--------+--------+--------|
     &kp ESC  &mt LCTRL A  &mt LALT S  &mt LSHFT D  &mt LGUI F  &kp G        &kp H    &mt RGUI J  &mt RSHFT K  &mt RALT L  &mt RCTRL SEMI  &kp BSLH
// |--------+--------+--------+--------+--------+--------|   |--------+--------+--------+--------+--------+--------|
     &kp LSHFT &kp Z   &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA &kp DOT &kp SLASH &kp RSHFT
//                          |--------+--------+--------|   |--------+--------+--------|
                                &kp LGUI &lt LOWER SPACE &kp LALT        &kp RALT &lt NAVIGATION RET &kp RGUI
//                          |--------+--------+--------|   |--------+--------+--------|
            >;
        };

        /* =========================================================
         * СЛОЙ 1: LOWER (цифры, F-клавиши, символы)
         * Активируется удержанием левого большого пальца (SPACE)
         * ========================================================= */
        lower_layer {
            bindings = <
// |--------+--------+--------+--------+--------+--------|   |--------+--------+--------+--------+--------+--------|
     &kp ESC  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp DEL
// |--------+--------+--------+--------+--------+--------|   |--------+--------+--------+--------+--------+--------|
     &trans   &kp F1   &kp F2   &kp F3   &kp F4   &kp F5       &kp F6   &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
// |--------+--------+--------+--------+--------+--------|   |--------+--------+--------+--------+--------+--------|
     &trans   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11      &kp F12  &kp LEFT &kp DOWN &kp UP   &kp RIGHT &kp INS
//                          |--------+--------+--------|   |--------+--------+--------|
                                &trans   &trans   &trans      &kp RET  &trans   &trans
//                          |--------+--------+--------|   |--------+--------+--------|
            >;
        };

        /* =========================================================
         * СЛОЙ 2: NAVIGATION (навигация, мультимедиа)
         * Активируется удержанием правого большого пальца (RET)
         * ========================================================= */
        navigation_layer {
            bindings = <
// |--------+--------+--------+--------+--------+--------|   |--------+--------+--------+--------+--------+--------|
     &kp GRAVE &kp F1   &kp F2   &kp F3   &kp F4   &kp F5       &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11
// |--------+--------+--------+--------+--------+--------|   |--------+--------+--------+--------+--------+--------|
     &kp LCTRL &kp LALT &kp LSHFT &kp LGUI &trans  &trans      &trans   &kp PG_UP &kp HOME &kp UP   &kp END  &kp F12
// |--------+--------+--------+--------+--------+--------|   |--------+--------+--------+--------+--------+--------|
     &trans   &trans   &trans   &trans   &trans   &trans      &trans   &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp DEL
//                          |--------+--------+--------|   |--------+--------+--------|
                                &trans   &trans   &trans      &trans   &trans   &trans
//                          |--------+--------+--------|   |--------+--------+--------|
            >;
        };
    };

    /* =========================================================
     * COMBOS (комбинации клавиш)
     * ========================================================= */
    combos {
        compatible = "zmk,combos";

        /* J + K = ESC (позиции 19 и 20) */
        combo_esc {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp ESC>;
        };

        /* F + J = TAB (позиции 15 и 18) */
        combo_tab {
            timeout-ms = <50>;
            key-positions = <15 18>;
            bindings = <&kp TAB>;
        };

        /* Q + W = ESC (альтернативный, позиции 1 и 2) */
        combo_esc_alt {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        };
    };
};
